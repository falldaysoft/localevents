# Instance overlay template.
#
# Copy this to ~/apps/<instance>/.env on the VM, beside deploy/docker-compose.yml
# and deploy/deploy.sh, and fill it in. Keep a copy locally as
# instances/<instance>.env — files in this directory other than this example
# are NOT committed (see .gitignore), which is what keeps a community's name,
# coordinates and credentials out of the reusable product. Losing it costs a
# re-derivation of everything below, not a redeploy.
#
# Compose reads this file twice: to interpolate its own ${...} references
# (INSTANCE, HOST, DB_PASSWORD, IMAGE_TAG) and to pass the whole file to the
# containers, where settings.py reads the rest by these exact names.
#
#   make deploy INSTANCE=<instance>              # deploys HEAD
#   make deploy INSTANCE=<instance> TAG=<sha>    # redeploy or roll back

# Where `make deploy` connects, with your own key. CI uses a restricted key
# of its own (see .github/workflows/build.yml).
DEPLOY_HOST=ubuntu@vm.example.org

# Directory under ~/apps on the VM, docker container prefix, Traefik router
# name, and the postgres role *and* database. Lowercase, no dots.
INSTANCE=yourtown
# Public hostname, no scheme, no www. Also ALLOWED_HOSTS and the mail links.
HOST=events.example.org

# Postgres role password. Create the role and database on the VM first:
#   docker exec postgres psql -U postgres -c "create role yourtown login password '...'"
#   docker exec postgres psql -U postgres -c "create database yourtown owner yourtown"
DB_PASSWORD=
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=
# Written by deploy.sh on every deploy. Leave it; it records what is running.
IMAGE_TAG=latest

SITE_NAME=Yourtown Events
SITE_TAGLINE=What's on in Yourtown
CONTACT_EMAIL=hello@events.example.org
# An IANA timezone name, e.g. America/Toronto, Europe/Lisbon.
SITE_TIMEZONE=UTC

# Where the map opens.
MAP_CENTER_LAT=0
MAP_CENTER_LNG=0
MAP_ZOOM=12
# min_lat,min_lng,max_lat,max_lng
#
# This is also the region gate: a submitted event that geocodes outside these
# bounds is flagged for a moderator rather than published. Draw it generously
# enough to include the surrounding area people actually travel to.
MAP_BBOX=-90,-180,90,180

EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@events.example.org
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional. Enrichment ships disabled and is switched on in the admin.
OPENROUTER_API_KEY=
