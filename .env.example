# Local development environment.
#
# Nothing here is required to run `make dev` — the defaults in settings.py are
# deliberately generic and workable. Copy to .env and edit if you want your
# local instance to resemble a real deployment.

DEBUG=true
SECRET_KEY=insecure-dev-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Instance identity. In production these come from the Helm values file.
SITE_NAME=Local Events
SITE_TAGLINE=What's on near you
CONTACT_EMAIL=hello@localhost
SITE_TIMEZONE=UTC

# Where the map opens, and the bounds outside which a geocoded event is
# flagged for review rather than published.
MAP_CENTER_LAT=0
MAP_CENTER_LNG=0
MAP_ZOOM=12
MAP_BBOX=-90,-180,90,180

# Email. The default console backend prints messages to stdout, which is what
# you want locally — confirmation links included.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# LLM enrichment. Only needed to exercise the enrichment path; the provider and
# model are chosen in the admin (AI configuration), these are just the keys.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
